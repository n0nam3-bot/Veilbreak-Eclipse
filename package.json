{
  "name": "veilbreak-eclipse",
  "version": "0.2.0",
  "private": true,
  "description": "An original anime-inspired 2.5D fighting game vertical slice for GitHub Pages and desktop wrapping.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis portable",
    "package:dir": "electron-builder --dir",
    "check": "node --check src/game.js && node --check electron/main.cjs"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.veilbreak.eclipse",
    "productName": "Veilbreak Eclipse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
